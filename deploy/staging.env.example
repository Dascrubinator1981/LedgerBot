# Template only. Supply real values through the hosting provider's secure runtime settings.
# Do not put populated files in Git, chat, image layers or build arguments.
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
LEDGERBOT_BACKEND=postgres
LEDGERBOT_APP_ORIGIN=
LEDGERBOT_COOKIE_SECURE=true
LEDGERBOT_SUPABASE_URL=
LEDGERBOT_SUPABASE_ANON_KEY=
LEDGERBOT_POSTGRES_URL=
LEDGERBOT_DRAFT_KEYS=
LEDGERBOT_DRAFT_ACTIVE_KEY_ID=current
LEDGERBOT_SIGNUPS_DISABLED=true
# Legacy read key only if recovering v1 envelopes/backups; never copy development keys.
LEDGERBOT_DRAFT_KEY=
