LEDGERBOT_DATABASE_PATH=./data/ledgerbot.sqlite
LEDGERBOT_APP_ORIGIN=http://127.0.0.1:3000
# Local development only. Production requires HTTPS and a security review.
LEDGERBOT_COOKIE_SECURE=false
# Set postgres only after applying migrations and configuring verified identity.
LEDGERBOT_BACKEND=sqlite
# The following server-only values must be supplied securely for a managed project.
LEDGERBOT_POSTGRES_URL=
LEDGERBOT_SUPABASE_URL=
LEDGERBOT_SUPABASE_ANON_KEY=
# Generate a 32-byte hexadecimal key; never commit a real value.
LEDGERBOT_DRAFT_KEY=
